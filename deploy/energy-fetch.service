[Unit]
Description=Trigger the energy fetch on GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/env bash /opt/energy-trigger/trigger.sh

# A dispatch is cheap and idempotent - the script skips when a run is already
# going - so a failure is worth retrying rather than waiting an hour.
Restart=on-failure
RestartSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

StandardOutput=journal
StandardError=journal
