[Unit]
Description=Trigger the energy fetch on GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
# Runs straight out of the clone at /opt/energy, the same arrangement as
# stockwatch: updating the trigger is then a git pull rather than a copy, and
# the script keeps the LF endings git checks out rather than the CRLF a copy
# from Windows would bring, which a shebang will not survive.
ExecStart=/opt/energy/deploy/trigger.sh
WorkingDirectory=/opt/energy

Restart=on-failure
RestartSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

StandardOutput=journal
StandardError=journal
